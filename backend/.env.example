DATABASE_URL=postgresql://exist:exist@localhost:5432/exist
JWT_SECRET=change-me-to-a-long-random-string
INSTITUTION_TZ=Asia/Kolkata
# dev = bind phones without hardware attestation. Use strict in production.
ATTESTATION_MODE=dev
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts session secrets at rest.
SECRETS_KEY=
PORT=8080
