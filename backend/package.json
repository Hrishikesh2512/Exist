{
  "name": "exist-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors": "tsx scripts/gen-vectors.ts",
    "db:push": "prisma db push",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
